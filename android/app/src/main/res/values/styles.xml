<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema della finestra mentre il processo parte, con il tema chiaro di
         sistema. Joyo è un'app scura in ogni caso: sfondo viola, non bianco. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema applicato appena il processo è partito: resta dietro alla UI
         Flutter mentre si inizializza. Deve essere lo stesso viola, altrimenti
         fra la schermata di avvio e la prima schermata si vede uno stacco. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/joyo_background</item>
    </style>
</resources>
