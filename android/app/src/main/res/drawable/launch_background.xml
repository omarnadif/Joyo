<?xml version="1.0" encoding="utf-8"?>
<!-- Schermata di avvio: viola di Joyo con il marchio al centro.
     Di serie Flutter mette il bianco, che su un'app scura si vedeva come un
     lampo a ogni apertura. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/joyo_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/joyo_splash" />
    </item>
</layer-list>
